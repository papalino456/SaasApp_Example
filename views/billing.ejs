<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Billing - SaasApp</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/modern-style.css">
</head>
<body>
  <!-- Background -->
  <div class="bg-pattern"></div>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a href="/" class="logo">
        <div class="logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        SaasApp
      </a>
      <div class="nav-links">
        <a href="/main" class="nav-link">Dashboard</a>
        <a href="/logout" class="btn btn-ghost">Sign out</a>
      </div>
    </div>
  </nav>

  <!-- Billing Page -->
  <main class="billing-page">
    <div class="billing-container">
      <div class="billing-header">
        <% if (subscriptionActive) { %>
          <div class="billing-status">
            <span style="width: 6px; height: 6px; background: currentColor; border-radius: 50%; animation: pulse 2s infinite;"></span>
            Premium Active
          </div>
        <% } %>
        <h1>Simple, transparent pricing</h1>
        <p>Choose the plan that's right for you</p>
      </div>

      <div class="pricing-grid">
        <!-- Free Tier -->
        <div class="pricing-card">
          <div class="pricing-header">
            <div class="pricing-tier">Starter</div>
            <div class="pricing-price">$0<span>/month</span></div>
          </div>
          <ul class="pricing-features">
            <li class="included">Single User</li>
            <li class="included">5GB Storage</li>
            <li class="included">Unlimited Public Projects</li>
            <li class="included">Community Access</li>
            <li>Unlimited Private Projects</li>
            <li>Dedicated Phone Support</li>
            <li>Free Subdomain</li>
            <li>Monthly Status Reports</li>
          </ul>
          <button class="btn btn-secondary pricing-btn" onclick="gotocheckout()">
            Get Started
          </button>
        </div>

        <!-- Plus Tier -->
        <div class="pricing-card featured">
          <div class="pricing-header">
            <div class="pricing-tier">Professional</div>
            <div class="pricing-price">$9<span>/month</span></div>
          </div>
          <ul class="pricing-features">
            <li class="included"><strong>5 Users</strong></li>
            <li class="included">50GB Storage</li>
            <li class="included">Unlimited Public Projects</li>
            <li class="included">Community Access</li>
            <li class="included">Unlimited Private Projects</li>
            <li class="included">Dedicated Phone Support</li>
            <li class="included">Free Subdomain</li>
            <li>Monthly Status Reports</li>
          </ul>
          <button class="btn btn-primary pricing-btn" onclick="gotocheckout()">
            Upgrade Now
          </button>
        </div>

        <!-- Pro Tier -->
        <div class="pricing-card">
          <div class="pricing-header">
            <div class="pricing-tier">Enterprise</div>
            <div class="pricing-price">$49<span>/month</span></div>
          </div>
          <ul class="pricing-features">
            <li class="included"><strong>Unlimited Users</strong></li>
            <li class="included">150GB Storage</li>
            <li class="included">Unlimited Public Projects</li>
            <li class="included">Community Access</li>
            <li class="included">Unlimited Private Projects</li>
            <li class="included">Dedicated Phone Support</li>
            <li class="included"><strong>Unlimited</strong> Free Subdomains</li>
            <li class="included">Monthly Status Reports</li>
          </ul>
          <button class="btn btn-primary pricing-btn" onclick="gotocheckout()">
            Go Enterprise
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <p>&copy; 2026 SaasApp. All rights reserved.</p>
  </footer>

  <!-- Stripe Integration -->
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    var stripe = Stripe('pk_test_placeholder');
    function gotocheckout() {
      stripe.redirectToCheckout({
        sessionId: "<%= sessionId %>"
      }).then(function (result) {
        if (result.error) {
          alert(result.error.message);
        }
      });
    }
  </script>
</body>
</html>
